generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffProfiles StaffProfile[]
  gamingReports GamingReport[]
  gamingConfig  GamingHubConfig?
  auditLogs     AuditLog[]
  notifications Notification[]
  staffDocuments StaffDocument[]
}

model StaffProfile {
  id                 String    @id @default(cuid())
  username           String    @unique
  passwordHash       String
  salt               String
  mustChangePassword Boolean   @default(true)
  fullName           String
  email              String?
  role               String    // super_admin | admin | management | counter_admin | computer_tech | team_leader
  branchId           String?
  status             String    @default("active") // active | inactive
  activatedAt        DateTime?
  deactivatedAt      DateTime?
  createdById        String?
  createdByName      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  branch   Branch?       @relation(fields: [branchId], references: [id])
  sessions StaffSession[]
  preparedDocuments StaffDocument[] @relation("DocumentAuthor")
  receivedDocuments StaffDocument[] @relation("DocumentRecipient")
  documentNotices DocumentNotice[]
  documentParticipations DocumentParticipant[]

  @@index([branchId, status])
}

model StaffSession {
  id        String   @id @default(cuid())
  staffId   String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  staff StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([expiresAt])
}

model GamingReport {
  id            String   @id @default(cuid())
  branchId      String
  reportDate    DateTime
  shift         String   // Opening | Mid | Night
  adminName     String?
  techName      String?
  status        String   @default("draft") // draft | submitted
  changes       String?
  followUp      String?
  reportData    String   // JSON string of report_data object
  createdByName String
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId, reportDate])
  @@index([branchId, status, reportDate])
}

model GamingHubConfig {
  id               String   @id @default(cuid())
  branchId         String   @unique
  standardPcs      String   @default("[]") // JSON array
  vipPcs           String   @default("[]")
  games            String   @default("[]")
  gameStatuses     String   @default("[]")
  shiftPcs         String   @default("{}") // JSON object
  spareTypes       String   @default("[]")
  peripheralBrands String   @default("{}") // JSON object by category
  updatedAt        DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  branchId    String?
  userId      String?
  userName    String
  role        String
  action      String
  entity      String
  entityId    String?
  description String
  createdAt   DateTime @default(now())

  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([branchId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  audience  String   @default("staff")
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  link      String?
  branchId  String?
  createdAt DateTime @default(now())

  branch Branch? @relation(fields: [branchId], references: [id])
}

model SystemSettings {
  id           String @id @default("default")
  businessName String @default("MARVS Gaming Hub")
  logoUrl      String?
  systemName   String @default("Gaming Hub Management System")
  updatedAt    DateTime @updatedAt
}

// Issued content is immutable. A correction is a separate linked revision.
model StaffDocument {
  id             String @id @default(cuid())
  kind           String
  title          String
  branchId       String
  branchName     String
  recipientId    String
  recipientName  String
  createdById    String
  preparedByName String
  initiatedByRole String @default("")
  workflowVersion Int @default(1)
  status         String @default("draft")
  content        Json
  contentVersion Int @default(1)
  lockVersion    Int @default(1)
  contentHash    String?
  revision       Int @default(1)
  supersedesId   String? @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branch         Branch @relation(fields: [branchId], references: [id])
  recipient      StaffProfile @relation("DocumentRecipient", fields: [recipientId], references: [id])
  author         StaffProfile @relation("DocumentAuthor", fields: [createdById], references: [id])
  supersedes     StaffDocument? @relation("DocumentRevision", fields: [supersedesId], references: [id])
  revisedBy      StaffDocument? @relation("DocumentRevision")
  signatures     DocumentSignature[]
  events         DocumentEvent[]
  notices        DocumentNotice[]
  participants   DocumentParticipant[]

  @@index([branchId, status, createdAt])
  @@index([recipientId, status])
  @@index([createdById, createdAt])
}

model DocumentSignature {
  id             String @id @default(cuid())
  documentId     String
  contentVersion Int
  contentHash    String
  purpose        String // prepared | approved | acknowledged
  signerId       String
  signerName     String
  signerRole     String
  image          String
  statement      String
  responseHash   String?
  signedAt       DateTime @default(now())
  document       StaffDocument @relation(fields: [documentId], references: [id])

  @@unique([documentId, contentVersion, purpose, signerId], map: "DocumentSignature_version_purpose_signer_key")
}

model DocumentParticipant {
  id           String @id @default(cuid())
  documentId   String
  staffId      String
  staffName    String
  status       String @default("pending")
  explanation  String @default("")
  responseNote String @default("")
  respondedAt  DateTime?
  document     StaffDocument @relation(fields: [documentId], references: [id])
  staff        StaffProfile @relation(fields: [staffId], references: [id])

  @@unique([documentId, staffId])
  @@index([staffId, status])
}

model DocumentEvent {
  id         String @id @default(cuid())
  documentId String
  actorId    String
  actorName  String
  action     String
  note       String?
  version    Int
  createdAt  DateTime @default(now())
  document   StaffDocument @relation(fields: [documentId], references: [id])

  @@index([documentId, createdAt])
}

model DocumentNotice {
  id         String @id @default(cuid())
  documentId String
  staffId    String
  message    String
  readAt     DateTime?
  createdAt  DateTime @default(now())
  document   StaffDocument @relation(fields: [documentId], references: [id])
  staff      StaffProfile @relation(fields: [staffId], references: [id])

  @@index([staffId, readAt, createdAt])
}
